{
  "_说明": "面板里的「设置」会改这个文件。{prompt}=指向任务文件的短指令，{cwd}=项目根目录，{perm}=按权限档位展开的参数，{here}=面板目录。",
  "agents": [
    {
      "id": "claude",
      "name": "Claude Code",
      "enabled": true,
      "cmd": "claude",
      "args": [
        "-p",
        "{prompt}",
        "{perm}"
      ],
      "permission": "max",
      "perm": {
        "max": {
          "args": [
            "--dangerously-skip-permissions"
          ]
        },
        "safe": {
          "args": [
            "--permission-mode",
            "acceptEdits"
          ]
        }
      },
      "modelFlag": "--model",
      "strengths": "架构设计、复杂推理、代码评审、拆解规划",
      "auth": {
        "mode": "official",
        "provider": "",
        "model": ""
      },
      "loginCmd": "claude"
    },
    {
      "id": "codex",
      "name": "Codex",
      "enabled": true,
      "cmd": "codex",
      "args": [
        "exec",
        "--skip-git-repo-check",
        "{perm}",
        "-C",
        "{cwd}",
        "-c",
        "model_providers.panel_legacy_codex.request_max_retries=10",
        "-c",
        "model_providers.panel_legacy_codex.stream_max_retries=20",
        "-c",
        "model_providers.panel_legacy_codex.stream_idle_timeout_ms=600000",
        "{prompt}"
      ],
      "permission": "max",
      "perm": {
        "max": {
          "args": [
            "--dangerously-bypass-approvals-and-sandbox"
          ]
        },
        "safe": {
          "args": [
            "-s",
            "workspace-write"
          ]
        }
      },
      "strengths": "按规格实现、改代码、补单元测试",
      "auth": {
        "mode": "official",
        "provider": "",
        "model": ""
      },
      "loginCmd": "codex login",
      "modelFlag": "-m"
    },
    {
      "id": "gemini",
      "name": "Gemini CLI",
      "enabled": true,
      "cmd": "gemini",
      "args": [
        "-p",
        "{prompt}",
        "{perm}"
      ],
      "permission": "max",
      "perm": {
        "max": {
          "args": [
            "--yolo"
          ]
        },
        "safe": {
          "args": [
            "--approval-mode",
            "auto_edit"
          ]
        }
      },
      "modelFlag": "-m",
      "strengths": "超长上下文、通读文档与数据手册、调研",
      "auth": {
        "mode": "official",
        "provider": "",
        "model": ""
      },
      "loginCmd": null
    },
    {
      "id": "grok",
      "name": "Grok",
      "enabled": true,
      "cmd": "grok",
      "args": [
        "-p",
        "{prompt}",
        "--cwd",
        "{cwd}",
        "{perm}",
        "--output-format",
        "streaming-json"
      ],
      "permission": "max",
      "perm": {
        "max": {
          "args": [
            "--always-approve",
            "--permission-mode",
            "bypassPermissions"
          ]
        },
        "safe": {
          "args": [
            "--permission-mode",
            "acceptEdits"
          ]
        }
      },
      "strengths": "快速实现、脚本与工具类代码",
      "stream": "grok-ndjson",
      "auth": {
        "mode": "official",
        "provider": "",
        "model": ""
      },
      "loginCmd": "grok login"
    },
    {
      "id": "deepseek",
      "name": "DeepSeek Harness",
      "enabled": true,
      "cmd": "dsh",
      "args": [
        "--profile",
        "headless",
        "{prompt}"
      ],
      "permission": "max",
      "perm": {
        "max": {
          "env": {
            "DSH_PERMISSION_MODE": "danger-full-access"
          }
        },
        "safe": {
          "env": {
            "DSH_PERMISSION_MODE": "workspace-write"
          }
        }
      },
      "strengths": "低成本批量任务、中文文档、简单模块",
      "auth": {
        "mode": "official",
        "provider": "",
        "model": ""
      },
      "loginCmd": null
    }
  ]
}
